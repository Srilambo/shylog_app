{
  "version": 2,
  "builds": [
    {
      "src": "shylog-backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "shylog_app/build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "shylog-backend/api/index.js"
    },
    {
      "src": "/health",
      "dest": "shylog-backend/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "shylog_app/build/web/index.html"
    }
  ]
}
